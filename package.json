{
  "name": "colormatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multiplayer color matching game: everyone matches the same 10 colors, picks are logged for later analysis.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/server/server/index.js",
    "simulate": "tsx scripts/simulate.ts",
    "seed-demo": "tsx scripts/seed-demo.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "chroma-js": "^3.3.0",
    "vanilla-colorful": "^0.7.2",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/chroma-js": "^3.1.3",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
